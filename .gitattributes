# Normalise line endings so a clone on Windows still produces scripts Linux can
# run. A shell script checked out with CRLF fails with "bad interpreter".
* text=auto eol=lf

*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.java      text eol=lf
*.xml       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.properties text eol=lf
Dockerfile  text eol=lf

# Windows-only helpers keep CRLF.
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Never normalise binaries.
*.pdf       binary
*.png       binary
*.jpg       binary
*.jar       binary
*.p12       binary
*.pfx       binary
