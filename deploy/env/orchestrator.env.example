# /etc/twokeyok/orchestrator/orchestrator.env
#
# Secrets and per-host settings for the TwoKeyOk MiddleWare Orchestrator.
# Read by systemd before the service starts; referenced from orchestrator.yml
# as ${VAR}. Keep this file at mode 0640, owner root, group twokeyok.
#
# Values must NOT be quoted — systemd passes them through literally.

# ---- Listener --------------------------------------------------------
ORCHESTRATOR_PORT=443
ORCHESTRATOR_TLS_ENABLED=true
ORCHESTRATOR_TLS_KEYSTORE=/etc/twokeyok/orchestrator/tls/server.p12
ORCHESTRATOR_TLS_KEYSTORE_PASSWORD=change-me
ORCHESTRATOR_TLS_KEYSTORE_TYPE=PKCS12

# ---- ADSS Signing Service -------------------------------------------
# On an ADSS host this really is localhost; the gateway is not usually
# reachable from anywhere else. Verify with --check-adss.
ADSS_SIGNING_URL=http://localhost:8777/adss/signing/hdsi
ADSS_CLIENT_ID=Orchestrator-Signing

# ---- Long-term validation (only for PAdES_BASELINE_LT / _LTA) -------
ADSS_VERIFICATION_URL=http://adss-verify.internal.example/adss/verification/dss
ADSS_TSA_URL=https://adss-tsa.internal.example:8778/adss/tsa
ADSS_OCSP_URL=http://adss-ocsp.internal.example/adss/ocsp

# ---- Remote Authorisation Service -----------------------------------
ADSS_RAS_URL=https://adss-ras.internal.example
ADSS_RAS_CLIENT_ID=orchestrator
ADSS_RAS_CLIENT_SECRET=

# ---- TLS material ----------------------------------------------------
# Client certificate presented to ADSS and RAS, and the truststore for them.
ADSS_CLIENT_PFX=/etc/twokeyok/orchestrator/tls/Client-Authentication-Key.pfx
ADSS_CLIENT_PFX_PASSWORD=
ADSS_TRUSTSTORE=/etc/twokeyok/orchestrator/tls/adss-truststore.jks
ADSS_TRUSTSTORE_PASSWORD=

# ---- e-Seal credential ----------------------------------------------
ESEAL_CERT_ALIAS=ministry_eseal_certificate
ESEAL_CREDENTIAL_PASSWORD=

# ---- Client secrets (BCrypt hashes) ---------------------------------
#   java -jar twokeyok-orchestrator.jar --hash-secret '<secret>'
HR_PORTAL_SECRET_HASH=
CASE_MGMT_SECRET_HASH=

# ---- Jasypt (only if the config uses ENC(...) values) ----------------
# JASYPT_ENCRYPTOR_PASSWORD=

# ---- IAM (only when bearer authentication is enabled) ----------------
ORCHESTRATOR_BEARER_ENABLED=false
IAM_ISSUER=
IAM_JWKS_URI=

# ---- JVM -------------------------------------------------------------
# Quoted so the file can also be sourced from a shell, not just by systemd.
JAVA_OPTS="-Xms256m -Xmx1024m -XX:+UseG1GC -Dfile.encoding=UTF-8"
