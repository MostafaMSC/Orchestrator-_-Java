    },
    "reason": {
      "include": true,
      "label": "Reason",
      "show_label": true,
      "position": { "x": 15, "y": 52, "width": 226, "height": 18 }
    },
    "location": {
      "include": true,
      "label": "Location",
      "show_label": true,
      "position": { "x": 15, "y": 74, "width": 183, "height": 18 }
    },
    "contact_info": {
      "include": true,
      "label": "Contact Info",
      "show_label": true,
      "position": { "x": 15, "y": 97, "width": 221, "height": 18 }
    },
    "hand_signature": {
      "include": true,
      "label": "Hand Signature",
      "show_label": false,
      "image_name": "hand-signature.png",
      "position": { "x": 84, "y": 127, "width": 179, "height": 100 }
    },
    "company_logo": {
      "include": false,
      "label": "Company Logo",
      "show_label": false,
