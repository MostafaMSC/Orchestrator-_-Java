    "y": 450,
    "width": 200,
    "height": 80,
    "page_no": 1
  },
  "fields": {
    "signed_by": {
      "include": true,
      "label": "Signed By",
      "show_label": true,
      "position": { "x": 14, "y": 5, "width": 197, "height": 18 }
    },
    "signing_date": {
      "include": true,
      "label": "Signing Date",
