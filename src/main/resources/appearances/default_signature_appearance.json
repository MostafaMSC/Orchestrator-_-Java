{
  "template_id": "default_signature_appearance",
  "name": "Default signature appearance",
  "description": "Natural person visible signature: name, date, reason, location and contact details, with room for a handwritten signature image.",
  "width": 463,
  "height": 250,
  "border": {
    "show": true,
    "color": { "r": 0, "g": 0, "b": 0 }
  },
  "text_font": {
    "name": "Arial",
    "size": 16,
    "color": { "r": 0, "g": 0, "b": 0 }
  },
  "signature_field": {
